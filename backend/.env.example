NODE_ENV=development
PORT=5000
MONGODB_URI=your_mongodb_atlas_uri
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# The API secret is the long value from the Cloudinary dashboard. It is not the numeric API key.
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
EMAIL_FROM=SkillConnect <onboarding@resend.dev>

# Used only by seed scripts. Never commit a real .env file.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Demo listings stay off in production unless you deliberately set SEED_DEMO=true.
# Passwords are required by npm run seed:demo and are never given a default.
SEED_DEMO=false
DEMO_PROVIDER_PASSWORD=
DEMO_CUSTOMER_PASSWORD=
